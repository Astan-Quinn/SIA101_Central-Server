# Central Supabase project; keep secret keys only on this server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_TIMEOUT=12
UTILITYTRACK_API_TOKEN=replace_with_a_long_random_utilitytrack_token
LIFECYCLETRACK_API_TOKEN=replace_with_a_long_random_lifecycletrack_token
MAINTAINTRACK_API_TOKEN=replace_with_a_long_random_maintaintrack_token
LIFECYCLETRACK_INBOX_TOKEN=replace_with_a_distinct_lifecycletrack_inbox_token
UTILITYTRACK_INBOX_TOKEN=replace_with_a_distinct_utilitytrack_inbox_token
MAINTAINTRACK_INBOX_TOKEN=replace_with_a_distinct_maintaintrack_inbox_token
MAX_REQUEST_BYTES=1048576
QUEUE_VISIBILITY_SECONDS=120
QUEUE_MAX_READS=8
